diff --git a/VoodooI2CHID/VoodooI2CPrecisionTouchpadHIDEventDriver.cpp b/VoodooI2CHID/VoodooI2CPrecisionTouchpadHIDEventDriver.cpp
index ddc5e7b..8d4e763 100644
--- a/VoodooI2CHID/VoodooI2CPrecisionTouchpadHIDEventDriver.cpp
+++ b/VoodooI2CHID/VoodooI2CPrecisionTouchpadHIDEventDriver.cpp
@@ -18,6 +18,21 @@ void VoodooI2CPrecisionTouchpadHIDEventDriver::enterPrecisionTouchpadMode() {
     OSData *value = OSData::withBytes(inputMode, sizeof(inputMode));
     digitiser.input_mode->setDataValue(value);
     OSSafeReleaseNULL(value);
+
+    // Some touchpads (e.g. Samsung Galaxy Book3 IMG4100) power up with surface and button
+    // reporting off and stay silent in PTP mode until the host turns them on, like Windows and Linux do.
+    UInt8 on[] = { 1 };
+    if (digitiser.surface_switch) {
+        OSData *v = OSData::withBytes(on, sizeof(on));
+        digitiser.surface_switch->setDataValue(v);
+        OSSafeReleaseNULL(v);
+    }
+    if (digitiser.button_switch) {
+        OSData *v = OSData::withBytes(on, sizeof(on));
+        digitiser.button_switch->setDataValue(v);
+        OSSafeReleaseNULL(v);
+    }
+    IOLog("%s::%s Surface switch %s, button switch %s\n", getName(), name, digitiser.surface_switch ? "on" : "absent", digitiser.button_switch ? "on" : "absent");
     ready = true;
 }
 
